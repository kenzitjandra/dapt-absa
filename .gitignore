# NEVER commit these. Yelp is multi-GB, checkpoints are ~500MB each.
# A single accidental `git add .` with these unignored will wedge the repo for
# everyone and GitHub will reject the push at 100MB/file anyway.
# No trailing slashes on the shared folders: in Colab they are symlinks,
# and a pattern like "data/" only matches real folders.
/data
/checkpoints
/checkpoints_smoke
/runs
/runs_smoke
/logs
*.npy
*.bin
*.safetensors
*.pt

# Colab / Python noise
__pycache__/
*.pyc
.ipynb_checkpoints
.DS_Store
/.venv
config_smoke.py
C_day5.ipynb
C_day4.ipynb
CONTEXT.md
B_week2.ipynb
B_week3.ipynb
B_week3_extra.ipynb
